rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Fields: uid, email, displayName, photoURL, role, createdAt
    //
    // Collection: products
    // Fields: id, name, price, category, brand, description, image, specs
    //
    // Collection: articles
    // Fields: id, title, category, excerpt, image, date
    //
    // Collection: users/{userId}/cart
    // Fields: productId, name, price, quantity, image
    //
    // Collection: orders
    // Fields: userId, userEmail, items, total, paymentMethod, shippingInfo, status, trackingNumber, createdAt
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         (request.auth.token.email == "minhpnhgcd220355@fpt.edu.vn" && request.auth.token.email_verified == true));
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
             data.uid is string &&
             data.email is string &&
             data.role in ['admin', 'user'];
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['name', 'price', 'category', 'brand', 'description', 'image']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 200 &&
             data.price is number && data.price >= 0 &&
             data.category is string &&
             data.brand is string &&
             data.description is string && data.description.size() < 5000 &&
             data.image is string;
    }

    function isValidCartItem(data) {
      return data.keys().hasAll(['productId', 'name', 'price', 'quantity']) &&
             data.productId is string &&
             data.name is string &&
             data.price is number &&
             data.quantity is int && data.quantity > 0;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && isOwner(userId) && isValidUser(request.resource.data) && 
                    (request.resource.data.role == 'user' || (request.resource.data.email == "minhpnhgcd220355@fpt.edu.vn" && request.resource.data.role == 'admin'));
      allow update: if isAdmin() || (isOwner(userId) && isValidUser(request.resource.data) && request.resource.data.role == resource.data.role);
    }

    match /users/{userId}/cart/{itemId} {
      allow read, write: if isOwner(userId);
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidProduct(request.resource.data);
      allow delete: if isAdmin();
    }

    match /articles/{articleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /customers/{customerId} {
      allow read: if isAdmin();
      allow write: if isAuthenticated() && isOwner(customerId);
    }

    match /{path=**} {
      allow read, write: if false;
    }
  }
}
